# ===== 全部配置均为可选，复制本文件为 .env 后修改，或直接设置环境变量 =====

# 服务端口（默认 3000）
PORT=3000

# GitHub Personal Access Token（可选但推荐）
# 未认证限额 60 次/小时，配置后提升为 5000 次/小时；公开仓库只读，无需勾选任何权限
GITHUB_TOKEN=

# GitHub API 地址（默认 https://api.github.com，网络受限可指向代理/镜像）
GITHUB_API_BASE=

# ---- AI 评分（加分项）：任意 OpenAI 兼容接口 ----
# 也可不在此配置，直接在页面右上角「AI 设置」中填写（保存在浏览器本地）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
